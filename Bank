    cout << "Account Number: " << AccountNumber[1] << endl;
    cout << "PIN: " << AccountPin[1] << endl;
    cout << "BALANCE: R " << AccountBalance[1] << endl;
    cout << endl;
 
    cout << "Customer 3: " << CustomerName[2] << endl;
    cout << "Account Number: " << AccountNumber[2] << endl;
    cout << "PIN: " << AccountPin[2] << endl;
    cout << "BALANCE: R " << AccountBalance[2] << endl;
    cout << endl;
}
 
void ExitSystem()
{
    cout << "`````````EXIT SYSTEM`````````" << endl;
    cout << endl;
 
    cout << "WE REALLY APPRECIATE YOU USING OUR BANKING SYSTEM." << endl;
}
 
void meun()
{
    int Options;
    Balance = initialBalance;
 
    do
    {
        cout << "############################################################" << endl;
        cout << "WELCOME TO ANDY'S EASY BANKING WHAT COULD WE HELP YOU WITH?" << endl;
        cout << "############################################################" << endl;
 
        cout << "Enter Customer 1: " << CustomerName[0] << endl;
        cout << "Enter your Account number: " << AccountNumber[0] << endl;
        cout << "Enter your pin: " << AccountPin[0] << endl;
        cout << "Enter your Account Balance: R " << AccountBalance[0] << endl;
        cout << endl;
 
        cout << "Enter Customer 2: " << CustomerName[1] << endl;
        cout << "Enter Your Account Number: " << AccountNumber[1] << endl;
        cout << "Enter your pin: " << AccountPin[1] << endl;
        cout << "Enter your Account Balance: R " << AccountBalance[1] << endl;
        cout << endl;
 
        cout << "Enter Customer 3: " << CustomerName[2] << endl;
        cout << "Enter Your Account Number: " << AccountNumber[2] << endl;
        cout << "Enter your pin: " << AccountPin[2] << endl;
        cout << "Enter your Account Balance: R " << AccountBalance[2] << endl;
        cout << endl;
 
        cout << "Enter 1 for DEPOSIT" << endl;
        cout << "Enter 2 for WITHDRAW" << endl;
        cout << "Enter 3 for SEND CASH" << endl;
        cout << "Enter 4 for CHECK BALANCE" << endl;
        cout << "Enter 5 for CUSTOMER INFORMATION" << endl;
        cout << "Enter 6 for EXIT" << endl;
        cin >> Options;
 
        switch (Options)
        {
        case 1:
            DepositAmount();
            break;
 
        case 2:
            WithdrawAmount();
            break;
 
        case 3:
            CashSending();
            break;
 
        case 4:
            BalanceCheck();
            break;
 
        case 5:
            CustomerInformation();
            break;
 
        case 6:
            ExitSystem();
            break;
 
        default:
            cout << "OUR BANKING SYSTEM DOES NOT OFFER SUCH AN OPTION." << endl;
            break;
        }
 
    } while (Options != ExitCode);
}
 
int main()
{
    meun();
 
    return 0;
}