include<iostream>
#include<string>
 
using namespace std;
 
// Banking Variables
double Deposit, Withdrawal, Balance;
double TransferAccount = 0;
int Cash;
 
// Initial Banking Variable
double initialBalance = 10000;
int ExitCode = 6;
 
// Array Of Customer Names
string CustomerName[3] = {"Sisanda Black", "Sloth Morgan", "Zinandi Ntombi"};
 
// Array of Account Numbers
int AccountNumber[3] = {1786, 2782, 6728};
 
// Array of Account Pins
int AccountPin[3] = {7867, 7009, 2525};
 
// Array Of Account Balances
int AccountBalance[3] = {7000, 78393, 43000};
 
int Options;
 
void DepositAmount()
{
    cout << "```````````DEPOSIT````````````" << endl;
    cout << endl;
 
    cout << "HOW MUCH MONEY DO YOU WANT TO DEPOSIT IN YOUR ACCOUNT?" << endl;
    cin >> Deposit;
 
    if (Deposit <= 0)
    {
        cout << "PLEASE ENTER A VALID DEPOSIT AMOUNT." << endl;
    }
    else
    {
        Balance = Balance + Deposit;
        initialBalance = Balance;
 
        cout << "DEPOSIT: R " << Deposit << endl;
        cout << "BALANCE: R " << Balance << endl;
        cout << "YOU HAVE SUCCESSFULLY DEPOSITED R " << Deposit << " INTO YOUR BANK ACCOUNT." << endl;
    }
}
 
void WithdrawAmount()
{
    cout << "`````````WITHDRAWAL````````" << endl;
    cout << endl;
 
    cout << "HOW MUCH DO YOU WANT TO WITHDRAW FROM YOUR ACCOUNT?" << endl;
    cin >> Withdrawal;
    cout << endl;
 
    if (Withdrawal <= 0)
    {
        cout << "PLEASE ENTER A VALID WITHDRAWAL AMOUNT." << endl;
    }
    else if (Withdrawal > Balance)
    {
        cout << "YOUR WITHDRAWAL MUST NOT EXCEED YOUR ACCOUNT BALANCE." << endl;
    }
    else
    {
        Balance = Balance - Withdrawal;
        initialBalance = Balance;
 
        cout << "BALANCE: R " << Balance << endl;
        cout << endl;
        cout << "YOU HAVE SUCCESSFULLY WITHDRAWN FROM YOUR ACCOUNT." << endl;
    }
}
 
void CashSending()
{
    cout << "`````````SEND CASH`````````" << endl;
    cout << endl;
 
    cout << "HOW MUCH DO YOU WANT TO SEND TO ANOTHER ACCOUNT?" << endl;
    cin >> Cash;
 
    if (Cash <= 0)
    {
        cout << "PLEASE ENTER A VALID AMOUNT." << endl;
    }
    else if (Cash > Balance)
    {
        cout << "THE AMOUNT YOU SEND CANNOT EXCEED YOUR ACCOUNT BALANCE." << endl;
    }
    else
    {
        Balance = Balance - Cash;
        initialBalance = Balance;
        TransferAccount = TransferAccount + Cash;
 
        cout << "BALANCE ON YOUR ACCOUNT: R " << Balance << endl;
        cout << endl;
        cout << "THE BALANCE ON THE TRANSFER ACCOUNT IS: R " << TransferAccount << endl;
    }
}
 
void BalanceCheck()
{
    cout << "`````````CHECK BALANCE`````````" << endl;
    cout << endl;
 
    cout << "BALANCE: R " << Balance << endl;
    cout << endl;
}
 
void CustomerInformation()
{
    cout << "Customer 1: " << CustomerName[0] << endl;
    cout << "Account Number: " << AccountNumber[0] << endl;
    cout << "PIN: " << AccountPin[0] << endl;
    cout << "BALANCE: R " << AccountBalance[0] << endl;
